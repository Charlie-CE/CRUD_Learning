{
  "openapi": "3.1.1",
  "info": {
    "title": "WebApplication2 | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7052"
    },
    {
      "url": "http://localhost:5280"
    }
  ],
  "paths": {
    "/user": {
      "post": {
        "tags": [
          "WebApplication2"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "WebApplication2"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/user/{id}": {
      "get": {
        "tags": [
          "WebApplication2"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUserRequest": {
        "required": [
          "plan_name",
          "planned_hours",
          "actual_hours",
          "abandoned"
        ],
        "type": "object",
        "properties": {
          "plan_name": {
            "type": "string"
          },
          "planned_hours": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "actual_hours": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "abandoned": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "WebApplication2"
    }
  ]
}